# LLM 评测报告生成配置
# 用法：cp .env.example .env 后填实际值；.env 已被 .gitignore 忽略，不会进 git。
# 改完 .env 后只需 `docker compose up -d evaluation`（不带 --build），秒级生效不编译。
#
# LLM_URL：OpenAI 兼容地址 或 Ollama 原生地址
#   - Ollama（URL 含 /api/generate）：本地模型，无需 API key
#   - OpenAI 兼容（URL 不含 /api/generate，自动补 /v1/chat/completions）：如 https://api.openai.com
LLM_URL=http://host.docker.internal:11434/api/generate

# LLM_API_KEY：OpenAI 兼容服务填 sk-xxx；本地 Ollama 留空
LLM_API_KEY=

# LLM_MODEL：模型名。Ollama 如 qwen2:latest；OpenAI 如 gpt-4o-mini
LLM_MODEL=qwen2:latest

# LLM_TIMEOUT_SECONDS：LLM 生成超时秒数（生成较慢，默认 120）
LLM_TIMEOUT_SECONDS=120
