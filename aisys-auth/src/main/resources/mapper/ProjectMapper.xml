<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aisys.auth.mapper.ProjectMapper">

    <resultMap id="projectMap" type="com.aisys.auth.entity.Project">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdBy" column="created_by"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="cols">id, tenant_id, name, description, created_by, status, created_at, updated_at</sql>

    <select id="selectById" resultMap="projectMap">
        SELECT <include refid="cols"/> FROM project WHERE id = #{id}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM project
        <where>
            <if test="keyword != null and keyword != ''">AND name ILIKE '%' || #{keyword} || '%'</if>
        </where>
    </select>

    <select id="page" resultMap="projectMap">
        SELECT <include refid="cols"/> FROM project
        <where>
            <if test="keyword != null and keyword != ''">AND name ILIKE '%' || #{keyword} || '%'</if>
        </where>
        ORDER BY created_at DESC LIMIT #{size} OFFSET #{offset}
    </select>

    <insert id="insert" parameterType="com.aisys.auth.entity.Project" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO project (tenant_id, name, description, created_by, status)
        VALUES (#{tenantId}, #{name}, #{description}, #{createdBy}, COALESCE(#{status}, 'active'))
    </insert>
</mapper>
